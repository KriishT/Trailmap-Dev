{
  "name": "@trailmap/integrations",
  "version": "0.1.0",
  "description": "Deliver evidence packs to compliance platforms and webhooks",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@trailmap/eslint-config": "*",
    "@trailmap/typescript-config": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  }
}
