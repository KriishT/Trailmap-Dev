{
  "name": "@trailmap/graph",
  "version": "0.1.0",
  "description": "Versioned, validated dependency-graph schema shared by every Trailmap package",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@trailmap/eslint-config": "*",
    "@trailmap/typescript-config": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  }
}
